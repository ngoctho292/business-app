# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — T-BUSINESS CMS
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://cms:cms_local_pw@localhost:5432/cms_dev
DB_USER=cms
DB_PASSWORD=cms_local_pw
DB_NAME=cms_dev
DB_PORT=5432

# Redis Cache & BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_local
MINIO_BUCKET_PUBLIC=media-public
MINIO_BUCKET_PRIVATE=media-private
MEDIA_CDN_BASE_URL=http://localhost/media-public

# Google Gemini AI Layer (ADR-002)
# Lấy API key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_DEFAULT=gemini-1.5-flash
GEMINI_MODEL_HEAVY=gemini-1.5-pro
GEMINI_RATE_LIMIT_RPM=14

# JWT Authentication
JWT_ACCESS_SECRET=super_secret_access_jwt_key_for_development_only_12345
JWT_ACCESS_TTL=900 # 15 minutes (in seconds)
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_for_development_only_67890
JWT_REFRESH_TTL=2592000 # 30 days (in seconds)

# Next.js Multi-tenant Renderer & ISR
RENDERER_URL=http://localhost:3000
RENDERER_REVALIDATE_SECRET=secret_revalidate_token_between_backend_and_renderer_123

# Observability & Logging
LOG_LEVEL=debug
OTEL_SERVICE_NAME=tbusiness-backend
